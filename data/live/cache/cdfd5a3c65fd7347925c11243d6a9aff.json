s/451529269/", "id": 451529269, "tags": [], "absolute_url": "", "date_created": "2025-09-07T23:07:32.109853-07:00", "date_modified": "2025-11-14T05:39:17.912472-08:00", "sha1": "", "page_count": null, "file_size": null, "filepath_local": null, "filepath_ia": "", "ia_upload_failure_count": null, "thumbnail": null, "thumbnail_status": 0, "plain_text": "", "ocr_status": null, "date_upload": null, "document_number": "", "attachment_number": null, "pacer_doc_id": "", "is_available": false, "is_free_on_pacer": null, "is_sealed": null, "document_type": 1, "description": "", "acms_document_guid": ""}], "date_created": "2025-09-07T23:07:32.094685-07:00", "date_modified": "2025-11-14T05:39:17.888199-08:00", "date_filed": "2024-04-11", "time_filed": null, "entry_number": null, "recap_sequence_number": "2024-04-11.003", "pacer_sequence_number": null, "description": "Order [non-document] granting Motion for appearance pro hac vice by attorney Sarah M. Ray for Oracle America, Inc. Local Rule 5.1(c) requires that attorneys register for NextGen CM/ECF and file and receive all documents electronically. NextGen CM/ECF registration can be done online at www.pacer.gov. Login with your PACER credentials, go to the Maintenance tab, click Attorney Admissions/E-File Registration, select Ohio Northern District Court and then select Pro Hac Vice. If you were previously granted pro hac vice status and are already registered to file electronically, it is not necessary to register again. (Related Doc # 8 ). Judge Charles Esque Fleming on 4/11/2024. (S,SR)", "tags": []}, {"resource_uri": "https://www.courtlistener.com/api/rest/v4/docket-entries/437066122/", "id": 437066122, "docket": "https://www.courtlistener.com/api/rest/v4/dockets/71269993/", "recap_documents": [{"resource_uri": "https://www.courtlistener.com/api/rest/v4/recap-documents/451529268/", "id": 451529268, "tags": [], "absolute_url": "", "date_created": "2025-09-07T23:07:32.079776-07:00", "date_modified": "2025-11-14T05:39:17.874998-08:00", "sha1": "", "page_count": null, "file_size": null, "filepath_local": null, "filepath_ia": "", "ia_upload_failure_count": null, "thumbnail": null, "thumbnail_status": 0, "plain_text": "", "ocr_status": null, "date_upload": null, "document_number": "", "attachment_number": null, "pacer_doc_id": "", "is_available": false, "is_free_on_pacer": null, "is_sealed": null, "document_type": 1, "description": "", "acms_document_guid": ""}], "date_created": "2025-09-07T23:07:32.063271-07:00", "date_modified": "2025-11-14T05:39:17.845949-08:00", "date_filed": "2024-04-11", "time_filed": null, "entry_number": null, "recap_sequence_number": "2024-04-11.002", "pacer_sequence_number": null, "description": "Order [non-document] granting Motion for appearance pro hac vice by attorney Robert C. Collins, III for Oracle America, Inc. Local Rule 5.1(c) requires that attorneys register for NextGen CM/ECF and file and receive all documents electronically. NextGen CM/ECF registration can be done online at www.pacer.gov. Login with your PACER credentials, go to the Maintenance tab, click Attorney Admissions/E-File Registration, select Ohio Northern District Court and then select Pro Hac Vice. If you were previously granted pro hac vice status and are already registered to file electronically, it is not necessary to register again. (Related Doc # 7 ). Judge Charles Esque Fleming on 4/11/2024.(S,SR)", "tags": []}]}