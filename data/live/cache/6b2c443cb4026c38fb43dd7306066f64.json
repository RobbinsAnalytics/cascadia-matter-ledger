00", "sha1": "", "page_count": null, "file_size": null, "filepath_local": null, "filepath_ia": "", "ia_upload_failure_count": null, "thumbnail": null, "thumbnail_status": 0, "plain_text": "", "ocr_status": null, "date_upload": null, "document_number": "26", "attachment_number": null, "pacer_doc_id": "035026660633", "is_available": false, "is_free_on_pacer": null, "is_sealed": null, "document_type": 1, "description": "Stipulation without Proposed Order", "acms_document_guid": ""}], "date_created": "2026-01-20T10:36:35.822425-08:00", "date_modified": "2026-03-27T15:02:34.717534-07:00", "date_filed": "2026-01-20", "time_filed": "10:15:53", "entry_number": 26, "recap_sequence_number": "2026-01-20.001", "pacer_sequence_number": 77, "description": "STIPULATION Extending Defendant Mixpanel, Inc.'s Time to Respond to Plaintiff's Complaint filed by Mixpanel, Inc.. (Drum, Starr) (Filed on 1/20/2026) (Entered: 01/20/2026)", "tags": []}, {"resource_uri": "https://www.courtlistener.com/api/rest/v4/docket-entries/450317951/", "id": 450317951, "docket": "https://www.courtlistener.com/api/rest/v4/dockets/71976865/", "recap_documents": [{"resource_uri": "https://www.courtlistener.com/api/rest/v4/recap-documents/465132471/", "id": 465132471, "tags": [], "absolute_url": "/docket/71976865/25/woodard-v-openai-inc/", "date_created": "2026-01-14T12:03:18.780952-08:00", "date_modified": "2026-03-27T15:02:34.686085-07:00", "sha1": "30b313de02463c30b6d602628f95656e1d3a190f", "page_count": 1, "file_size": 261893, "filepath_local": "recap/gov.uscourts.cand.460558/gov.uscourts.cand.460558.25.0.pdf", "filepath_ia": "https://archive.org/download/gov.uscourts.cand.460558/gov.uscourts.cand.460558.25.0.pdf", "ia_upload_failure_count": null, "thumbnail": null, "thumbnail_status": 0, "plain_text": "          Case 3:25-cv-10301-VC           Document 25         Filed 01/14/26        Page 1 of 1\n\n\n\n                            UNITED STATES DISTRICT COURT\n                          NORTHERN DISTRICT OF CALIFORNIA\n\n                                    RELATED CASE ORDER\n\n\n        A Motion for Administrative Relief to Consider Whether Cases Should be Related or a\nSua Sponte Judicial Referral for Purpose of Determining Relationship (Civil L.R. 3-12) has been\nfiled. The time for filing an opposition or statement of support has passed. As the judge assigned\nto case\n\n       25-cv-10301-VC\n       Woodard v. OpenAI, Inc.\n\n        I find that the more recently filed case(s) that I have initialed below are related to the case\nassigned to me, and such case(s) shall be reassigned to me. Any cases listed below that are not\nrelated to the case assigned to me are referred to the judge assigned to the next-earliest filed case\nfor a related case determination.\n\n\nCase            Title                              Related Not Related\n25-cv-10312-AGT ZEBRALINE GROUP, LLC v. OPENAI L.P  VC\n\n                                               ORDER\n\n         The parties are instructed that all future filings in any reassigned case are to bear the\ninitials of the newly assigned judge immediately after the case number. Any case management\nconference in any reassigned case will be rescheduled by the Court. The parties shall adjust the\ndates for the conference, disclosures and report required by FRCivP 16 and 26 accordingly.\nUnless otherwise ordered, any dates for hearing noticed motions are vacated and must be re-\nnoticed by the moving party before the newly assigned judge; any deadlines set by the ADR Local\nRules remain in effect; and any deadlines established in a case management order continue to\ngovern, except dates for appearance in court, which will be rescheduled by the newly assigned\njudge.\n\n\nDated: January 14, 2026                        By:\n                                                     Vince Chhabria\n                                                     United States District Judge\n\n\n\n\n                                                     1\n\f", "ocr_status": 2, "date_upload": "2026-01-26T23:11:03.008917-08:00", "document_number": "25", "attachment_number": null, "pacer_doc_id": "035026643447", "is_available": true, "is_free_on_pacer": null, "is_sealed": null, "document_type": 1, "description": "Order Relating Case", "acms_document_guid": ""}], "date_created": "2026-01-14T12:03:18.749296-08:00", "date_modified": "2026-03-27T15:02:34.645387-07:00", "date_filed": "2026-01-14", "time_filed": "11:40:03", "entry_number": 25, "recap_sequence_number": "2026-01-14.002", "pacer_sequence_number": 71, "description": "ORDER RELATING CASES: 25-cv-10301-VC & 25-cv-10312-AGT. Signed by Judge Vince Chhabria on 1/14/2026. (bxs, COURT STAFF) (Filed on 1/14/2026) (Entered: 01/14/2026)", "tags": []}, {"resource_uri": "https://www.courtlistener.com/api/rest/v4/docket-entries/450290356/", "id": 450290356, "docket": "https://www.courtlistener.com/api/rest/v4/dockets/71976865/", "recap_documents": [{"resource_uri": "https://www.courtlistener.com/api/rest/v4/recap-documents/465104476/", "id": 465104476, "tags": [], "absolute_url": "/docket/71976865/24/woodard-v-openai-inc/", "date_created": "2026-01-14T10:05:12.877892-08:00", "date_modified": "2026-03-27T15:02:34.608202-07:00", "sha1": "", "page_count": null, "file_size": null, "filepath_local": null, "filepath_ia": "", "ia_upload_failure_count": null, "thumbnail": null, "thumbnail_status": 0, "plain_text": "", "ocr_status": null, "date_upload": null, "document_number": "24", "attachment_number": null, "pacer_doc_id": "035026642662", "is_available": false, "is_free_on_pacer": null, "is_sealed": null, "document_type": 1, "description": "Stipulation without Proposed Order", "acms_document_guid": ""}], "date_created": "2026-01-14T10:05:12.853551-08:00", "date_modified": "2026-03-27T15:02:34.565999-07:00", "date_filed": "2026-01-14", "time_filed": "09:52:02", "entry_number": 24, "recap_sequence_number": "2026-01-14.001", "pacer_sequence_number": 69, "description": "STIPULATI