ntries/421981928/", "id": 421981928, "docket": "https://www.courtlistener.com/api/rest/v4/dockets/69746187/", "recap_documents": [{"resource_uri": "https://www.courtlistener.com/api/rest/v4/recap-documents/435997613/", "id": 435997613, "tags": [], "absolute_url": "/docket/69746187/13/wright-v-smart-erp-solutions-inc/", "date_created": "2025-04-10T09:35:13.829935-07:00", "date_modified": "2025-04-17T01:47:56.363238-07:00", "sha1": "b01e67c506fe3984f558ef81b4ea0080af664ec4", "page_count": 3, "file_size": 185251, "filepath_local": "recap/gov.uscourts.cand.446502/gov.uscourts.cand.446502.13.0.pdf", "filepath_ia": "https://archive.org/download/gov.uscourts.cand.446502/gov.uscourts.cand.446502.13.0.pdf", "ia_upload_failure_count": null, "thumbnail": null, "thumbnail_status": 0, "plain_text": "        Case 4:25-cv-02588-HSG             Document 13        Filed 04/10/25      Page 1 of 3\n\n\n\n                              UNITED STATES DISTRICT COURT\n                          NORTHERN DISTRICT OF CALIFORNIA\n\n\n                                       RELATED CASE ORDER\n        A Motion for Administrative Relief to Consider Whether Cases Should be Related or a\nSua Sponte Judicial Referral for Purpose of Determining Relationship (Civil L.R. 3-12) has been\nfiled. The time for filing an opposition or statement of support has passed. As the judge assigned\nto case\n                    25-cv-02588-HSG         Wright v. Smart ERP Solutions, Inc.\n        I find that the more recently filed case(s) that I have initialed below are related to the case\nassigned to me, and such case(s) shall be reassigned to me. Any cases listed below that are not\nrelated to the case assigned to me are referred to the judge assigned to the next-earliest filed case\nfor a related case determination.\n\n\n        Case                   Title                                     Related Not Related\n        25-cv-02597-SK         Newson v. Smart ERP Solutions, Inc.        HSG\n        25-cv-02637-RFL        Finley v. Smart ERP Solutions, Inc.        HSG\n        25-cv-02639-RFL        Demmie v. Smart ERP Solutions, Inc.        HSG\n        25-cv-02652-AGT        Diaz v. Smart ERP Solutions, Inc.          HSG\n        25-cv-02751-JSW        Hines v. Smart ERP Solutions, Inc.         HSG\n        25-cv-02877-KAW Aguilera v. Smart ERP Solutions, Inc.             HSG\n\n\n                                               ORDER\n         The parties are instructed that all future filings in any reassigned case are to bear the\ninitials of the newly assigned judge immediately after the case number. Any case management\nconference in any reassigned case will be rescheduled by the Court. The parties shall adjust the\ndates for the conference, disclosures and report required by FRCivP 16 and 26 accordingly.\nUnless otherwise ordered, any dates for hearing noticed motions are vacated and must be re-\nnoticed by the moving party before the newly assigned judge; any deadlines set by the ADR Local\nRules remain in effect; and any deadlines established in a case management order continue to\n//\n//\n\n\n                                                   1\n\f        Case 4:25-cv-02588-HSG          Document 13       Filed 04/10/25       Page 2 of 3\n\n\n\ngovern, except dates for appearance in court, which will be rescheduled by the newly assigned\njudge.\n\n\nDated: 4/10/2025                                By:\n                                                Haywood S. Gilliam, Jr.\n                                                United States District Judge\n\n\n\n\n                                               2\n\f         Case 4:25-cv-02588-HSG     Document 13      Filed 04/10/25       Page 3 of 3\n\n\n\n                        UNITED STATES DISTRICT COURT\n                      NORTHERN DISTRICT OF CALIFORNIA\n\n\n                                  CLERK\u2019S NOTICE\n       The court has reviewed the motion and determined that no cases are related and no\nreassignments shall occur.\n\n\n\n\nDated:                                     By:\n                                           Nikki D. Riley, Deputy Clerk\n\n\n\n\n                                           3\n\f", "ocr_status": 2, "date_upload": "2025-04-11T01:58:49.098357-07:00", "document_number": "13", "attachment_number": null, "pacer_doc_id": "035025613210", "is_available": true, "is_free_on_pacer": true, "is_sealed": null, "document_type": 1, "description": "Order on Administrative Motion per Civil Local Rule 7-11", "acms_document_guid": ""}], "date_created": "2025-04-10T09:35:13.798865-07:00", "date_modified": "2025-04-17T01:47:56.353492-07:00", "date_filed": "2025-04-10", "time_filed": "09:09:13", "entry_number": 13, "recap_sequence_number": "2025-04-10.001", "pacer_sequence_number": 34, "description": "RELATED CASE ORDER by Judge Haywood S. Gilliam, Jr. RE DOCKET NO.    11 .  (ndr, COURT STAFF) (Filed on 4/10/2025)", "tags": []}, {"resource_uri": "https://www.courtlistener.com/api/rest/v4/docket-entries/421951628/", "id": 421951628, "docket": "https://www.courtlistener.com/api/rest/v4/dockets/69746187/", "recap_documents": [{"resource_uri": "https://www.courtlistener.com/api/rest/v4/recap-documents/435966588/", "id": 435966588, "tags": [], "absolute_url": "/docket/69746187/12/wright-v-smart-erp-solutions-inc/", "date_created": "2025-04-10T06:30:55.144068-07:00", "date_modified": "2025-04-10T06:30:55.147738-07:00", "sha1": "", "page_count": null, "file_size": null, "filepath_local": null, "filepath_ia": "", "ia_upload_failure_count": null, "thumbnail": null, "thumbnail_status": 0, "plain_text": "", "ocr_status": null, "date_upload": null, "document_number": "12", "attachment_number": null, "pacer_doc_id": "035025612857", "is_available": false, "is_free_on_pacer": null, "is_sealed": null, "document_type": 1, "description": "Summons Returned Executed", "acms_document_guid": ""}], "date_created": "2025-04-10T06:30:55.125169-07:00", "date_modified": "2025-04-10T06:30:55.132