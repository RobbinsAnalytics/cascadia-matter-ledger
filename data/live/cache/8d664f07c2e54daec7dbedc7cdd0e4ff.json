                       2\n\n                                   3\n\n                                   4\n\n                                   5                                   UNITED STATES DISTRICT COURT\n\n                                   6                                  NORTHERN DISTRICT OF CALIFORNIA\n\n                                   7\n\n                                   8     MS. A HOLDINGS, LLC, et al.,                       Case No. 26-cv-00329-SVK\n                                   9                    Plaintiffs,\n                                                                                            ORDER TO SHOW CAUSE RE\n                                  10              v.                                        SETTLEMENT\n                                  11     PORSCHE CARS NORTH AMERICA,                        Re: Dkt. No. 14\n                                         INC.,\n                                  12\nNorthern District of California\n\n\n\n\n                                                        Defendant.\n United States District Court\n\n\n\n\n                                  13\n                                              The Parties report that this case has settled. All previously scheduled deadlines and\n                                  14\n                                       appearances, including the April 14, 2026 case management conference, are VACATED.\n                                  15\n                                              By June 9, 2026, the Parties shall file a stipulation of dismissal. If a stipulation of\n                                  16\n                                       dismissal is not filed by the specified date, then the Parties shall appear on June 9, 2026 at 9:30\n                                  17\n                                       a.m. and show cause, if any, why the case should not be dismissed. Additionally, the Parties shall\n                                  18\n                                       file a statement in response to this Order no later than June 2, 2026, describing with specificity\n                                  19\n                                       (1) the Parties\u2019 efforts to finalize settlement within the time provided, and (2) whether additional\n                                  20\n                                       time is necessary, the reasons therefor and the minimum amount of time required to finalize the\n                                  21\n                                       settlement and file the stipulation of dismissal.\n                                  22\n                                              If a stipulation of dismissal is filed as ordered, the Order to Show Cause hearing will be\n                                  23\n                                       automatically vacated and the Parties need not file a statement in response to this Order.\n                                  24\n                                              SO ORDERED.\n                                  25\n                                       Dated: March 27, 2026\n                                  26\n\n                                  27                                                                 SUSAN VAN KEULEN\n                                                                                                     United States Magistrate Judge\n                                  28\n\f", "ocr_status": 2, "date_upload": "2026-07-04T17:06:39.729801-07:00", "document_number": "15", "attachment_number": null, "pacer_doc_id": "035026927021", "is_available": true, "is_free_on_pacer": true, "is_sealed": null, "document_type": 1, "description": "Order", "acms_document_guid": ""}], "date_created": "2026-03-27T12:32:18.305722-07:00", "date_modified": "2026-07-04T17:06:15.090781-07:00", "date_filed": "2026-03-27", "time_filed": "12:16:22", "entry_number": 15, "recap_sequence_number":