2025-09-04T12:02:29.459593-07:00", "date_modified": "2026-02-22T22:04:47.368511-08:00", "sha1": "277141d391d7fee70d5e1c201dbdd8f47fda2602", "page_count": 1, "file_size": 179766, "filepath_local": "recap/gov.uscourts.cand.455424/gov.uscourts.cand.455424.13.0.pdf", "filepath_ia": "https://archive.org/download/gov.uscourts.cand.455424/gov.uscourts.cand.455424.13.0.pdf", "ia_upload_failure_count": null, "thumbnail": null, "thumbnail_status": 0, "plain_text": "         Case 3:25-cv-07232-JSC           Document 14         Filed 09/04/25        Page 1 of 1\n\n\n\n                            UNITED STATES DISTRICT COURT\n                          NORTHERN DISTRICT OF CALIFORNIA\n\n                                    RELATED CASE ORDER\n\n\n        A Motion for Administrative Relief to Consider Whether Cases Should be Related (Civil\nL.R. 3-12) has been filed. The time for filing an opposition or statement of support has passed.\nAs the judge assigned to case\n\n       25-cv-07232-JSC\n       Scott v. Salesforce, Inc.\n\n       I find that the more recently filed cases that I have initialed below are related to the case\nassigned to me, and such cases shall be reassigned to me.\n\n\n Case                  Title                      Related Not Related\n 25-cv-07245-LB        Medina v. Salesforce, Inc. JSC\n 25-cv-07306-JD        Canick v. Salesforce, Inc.  JSC\n 25-cv-07318-LJC       Morgan v. Salesforce Inc.   JSC\n\n                                              ORDER\n\n         The parties are instructed that all future filings in any reassigned case are to bear the\ninitials of the newly assigned judge immediately after the case number. Any case management\nconference in any reassigned case will be rescheduled by the Court. The parties shall adjust the\ndates for the conference, disclosures and report required by Federal Rules of Civil Procedure 16\nand 26 accordingly. Unless otherwise ordered, any dates for hearing noticed motions are vacated\nand must be re-noticed by the moving party before the newly assigned judge; any deadlines set by\nthe ADR Local Rules remain in effect; and any deadlines established in a case management order\ncontinue to govern, except dates for appearance in court, which will be rescheduled by the newly\nassigned judge.\n\n\nDated: September 4, 2025                       By:\n                                                     Jacqueline Scott Corley\n                                                     United States District Judge\n\n\n\n\n                                                     1\n\f", "ocr_status": 2, "date_upload": "2025-09-10T22:32:02.048548-07:00", "document_number": "13", "attachment_number": null, "pacer_doc_id": "035026158930", "is_available": true, "is_free_on_pacer": null, "is_sealed": null, "document_type": 1, "description": "Order Relating Case", "acms_document_guid": ""}], "date_created": "2025-09-04T12:02:29.443475-07:00", "date_modified": "2026-02-22T22:04:47.346569-08:00", "date_filed": "2025-09-04", "time_filed": "11:40:47", "entry_number": 13, "recap_sequence_number": "2025-09-04.001", "pacer_sequence_number": 50, "description": "ORDER RELATING CASE. Signed by Judge Jacqueline Scott Corley on 9/4/2025. 25-cv-07245-LB, 25-cv-07306-JD, 25-cv-07318-LJC are related to 25-cv-7232-JSC. (ahm, COURT STAFF) (Filed on 9/4/2025) (Entered: 09/04/2025)", "tags": []}, {"resource_uri": "https://www.courtlistener.com/api/rest/v4/docket-entries/436731476/", "id": 436731476, "docket": "https://www.courtlistener.com/api/rest/v4/dockets/71229900/", "recap_documents": [{"resource_uri": "https://www.courtlistener.com/api/rest/v4/recap-documents/451185178/", "id": 451185178, "tags": [], "absolute_url": "/docket/71229900/12/canick-v-salesforce-inc/", "date_created": "2025-09-03T23:34:06.971642-07:00", "date_modified": "2026-02-22T22:04:47.325224-08:00", "sha1": "", "page_count": null, "file_size": null, "filepath_local": null, "filepath_ia": "", "ia_upload_failure_count": null, "thumbnail": null,