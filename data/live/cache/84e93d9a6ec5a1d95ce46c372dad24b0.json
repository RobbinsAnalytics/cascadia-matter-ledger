 1, "date_upload": "2025-06-11T01:51:24.206791-07:00", "document_number": "31", "attachment_number": null, "pacer_doc_id": "035025841876", "is_available": true, "is_free_on_pacer": true, "is_sealed": null, "document_type": 1, "description": "Order on Stipulation selecting Mediation", "acms_document_guid": ""}], "date_created": "2025-06-10T08:35:18.122432-07:00", "date_modified": "2025-07-10T01:51:46.927817-07:00", "date_filed": "2025-06-10", "time_filed": "08:28:53", "entry_number": 31, "recap_sequence_number": "2025-06-10.001", "pacer_sequence_number": 89, "description": "ORDER  by Judge Haywood S. Gilliam, Jr. GRANTING  30   Stipulation Selecting Mediation.  (ndr, COURT STAFF) (Filed on 6/10/2025)", "tags": []}, {"resource_uri": "https://www.courtlistener.com/api/rest/v4/docket-entries/427975454/", "id": 427975454, "docket": "https://www.courtlistener.com/api/rest/v4/dockets/69476214/", "recap_documents": [{"resource_uri": "https://www.courtlistener.com/api/rest/v4/recap-documents/442187031/", "id": 442187031, "tags": [], "absolute_url": "/docket/69476214/30/join-digital-inc-v-pivium-inc/", "date_created": "2025-06-10T06:35:32.468037-07:00", "date_modified": "2025-06-10T06:35:32.479969-07:00", "sha1": "", "page_count": null, "file_size": null, "filepath_local": null, "filepath_ia": "", "ia_upload_failure_count": null, "thumbnail": null, "thumbnail_status": 0, "plain_text": "", "ocr_status": null, "date_upload": null, "document_number": "30", "attachment_number": null, "pacer_doc_id": "035025841608", "is_available": false, "is_free_on_pacer": null, "is_sealed": null, "document_type": 1, "description": "Stipulation and Proposed Order selecting Mediation", "acms_document_guid": ""}], "date_created": "2025-06-10T06:35:32.451907-07:00", "date_modified": "2025-06-10T06:35:32.454438-07:00", "date_filed": "2025-06-10", "time_filed": "06:08:23", "entry_number": 30, "recap_sequence_number": "2025-06-10.001", "pacer_sequence_number": 87, "description": "", "tags": []}, {"res