676/70/janie-jack-llc-v-abbasi/", "date_created": "2025-03-10T09:37:12.566838-07:00", "date_modified": "2026-03-02T16:47:29.794499-08:00", "sha1": "0a091a7ce8d085ebb7c1bcd3e73639de47237a66", "page_count": 1, "file_size": 597660, "filepath_local": "recap/gov.uscourts.cand.445082/gov.uscourts.cand.445082.70.0.pdf", "filepath_ia": "https://archive.org/download/gov.uscourts.cand.445082/gov.uscourts.cand.445082.70.0.pdf", "ia_upload_failure_count": null, "thumbnail": null, "thumbnail_status": 0, "plain_text": "       Case 3:25-cv-01913-AMO            Document 70        Filed 03/10/25       Page 1 of 1\n\n\n                                                                                     Reset Form\n\n                                 UNITED STATES DISTRICT COURT\n\n                           NORTHERN DISTRICT OF CALIFORNIA\n\n\nJANIE & JACK LLC                                                25-cv-01913-SK\n                                                     Case No.\n                 Plaintiff(s),\n                                                     CONSENT OR DECLINATION\n          v.                                         TO MAGISTRATE JUDGE\n                                                     JURISDICTION\nDIANA ABBASI, et al.\n                 Defendant(s).\n\nINSTRUCTIONS: Please indicate below by checking one of the two boxes whether you (if you\nare the party) or the party you represent (if you are an attorney in the case) choose(s) to consent\nor decline to magistrate judge jurisdiction in this matter. Sign this form below your selection.\n\n       \u2610 CONSENT to Magistrate Judge Jurisdiction\n\n        In accordance with the provisions of 28 U.S.C. \u00a7 636(c), I voluntarily consent to have a\nUnited States magistrate judge conduct all further proceedings in this case, including trial and\nentry of final judgment. I understand that appeal from the judgment shall be taken directly to the\nUnited States Court of Appeals for the Ninth Circuit.\n\n       OR\n\n       \u2714 DECLINE Magistrate Judge Jurisdiction\n       \u2610\n\n       In accordance with the provisions of 28 U.S.C. \u00a7 636(c), I decline to have a United States\nmagistrate judge conduct all further proceedings in this case and I hereby request that this case be\nreassigned to a United States district judge.\n\n DATE: March 10\n       _______________,    25\n                        20____                    NAME: Sean P. Killeen\n\n                                                           /s/ Sean P. Killeen\n                                                                       Signature\n                                          COUNSEL FOR\n                                          (OR \u201cPRO SE\u201d): Janie & Jack, LLC\n\f", "ocr_status": 2, "date_upload": "2025-06-02T11:09:59.544417-07:00", "document_number": "70", "attachment_number": null, "pacer_doc_id": "035025493678", "is_available": true, "is_free_on_pacer": null, "is_sealed": null, "document_type": 1, "description": "Consent/Declination to Proceed Before a US Magistrate Judge", "acms_document_guid": ""}], "date_created": "2025-03-10T09:37:12.545381-07:00", "date_modified": "2026-03-02T16:47:29.768996-08:00", "date_filed": "2025-03-10", "time_filed": "09:08:56", "entry_number": 70, "recap_sequence_number": "2025-03-10.001", "pacer_sequence_number": 1885, "description": "CONSENT/DECLINATION to Proceed Before a US Magistrate Judge by Janie & Jack LLC.. (Killeen, Sean) (Filed on 3/10/2025) (Entered: 03/10/2025)", "tags": []}, {"resource_uri": "https://www.courtlistener.com/api/rest/v4/docket-entries/417731391/", "id": 417731391, "docket": "https://www.courtlistener.com/api/rest/v4/dockets/69666676/", "recap_documents": [{"resource_uri": "https://www.courtlistener.com/api/rest/v4/recap-documents/431503430/", "id": 431503430, "tags": [], "absolute_url": "", "date_created": "2025-02-27T08:31:27.228443-08:00", "date_modified": "2025-02-27T08:31:30.746640-08:00", "sha1": "", "page_count": n